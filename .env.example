# AegisScan 환경변수 예시 — 이 파일을 .env로 복사해서 사용합니다.
# 코드(src/aegisscan/config.py)가 실제로 읽는 값만 적었습니다.

# DB (기본값: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./aegisscan.db

# 외부 관측 API 키 (선택, external 명령에서 사용)
# Shodan: https://account.shodan.io
SHODAN_API_KEY=

# Censys: https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=
